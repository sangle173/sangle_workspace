<%- include('./partials/header') %>

<div class="row mb-4">
  <div class="col-md-12">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="card-title">Generate Report</h1>
        <p class="text-muted">Select the type of report you want to generate</p>
        
        <!-- Board Selection -->
        <div class="mb-4">
          <form action="/reports" method="GET" class="row g-3">
            <input type="hidden" name="type" value="<%= reportType %>">
            <div class="col-md-6 offset-md-3">
              <label for="boardId" class="form-label">Select Board:</label>
              <div class="input-group">
                <select class="form-select" id="boardId" name="boardId">
                  <% if (boards && boards.length > 0) { %>
                    <% boards.forEach(board => { %>
                      <option value="<%= board.id %>" <%= currentBoardId == board.id ? 'selected' : '' %>><%= board.name %></option>
                    <% }); %>
                  <% } else { %>
                    <option value="1">Default Board</option>
                  <% } %>
                </select>
                <button class="btn btn-outline-primary" type="submit">Switch Board</button>
              </div>
            </div>
          </form>
        </div>
        
        <div class="d-flex justify-content-center gap-3 my-4">
          <a href="/reports/daily?boardId=<%= currentBoardId %>" class="btn <%= reportType === 'daily' ? 'btn-primary' : 'btn-outline-primary' %>">
            Daily Report
          </a>
          <a href="/reports/weekly?boardId=<%= currentBoardId %>" class="btn <%= reportType === 'weekly' ? 'btn-primary' : 'btn-outline-primary' %>">
            Weekly Report
          </a>
          <a href="/reports/custom?boardId=<%= currentBoardId %>" class="btn <%= reportType === 'custom' ? 'btn-primary' : 'btn-outline-primary' %>">
            Custom Date Range
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>
