<%- include('./partials/header') %>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h2 class="mb-0">Application Settings</h2>
        </div>
        <div class="card-body">
          <% if (typeof success === 'string' && success) { %>
            <div class="alert alert-success" role="alert">
              <%= success %>
            </div>
          <% } %>
          <% if (typeof error === 'string' && error) { %>
            <div class="alert alert-danger" role="alert">
              <%= error %>
            </div>
          <% } %>

          <form action="/settings/update-api" method="POST">
            <div class="mb-4">
              <h4>API Configuration</h4>
              <p class="text-muted">Change the API endpoint URL to connect to different servers</p>
              
              <div class="form-group mb-3">
                <label for="apiEndpoint" class="form-label">API Endpoint URL</label>
                <input 
                  type="text" 
                  class="form-control" 
                  id="apiEndpoint" 
                  name="apiEndpoint"
                  placeholder="http://172.18.100.184/mini_project/public/api" 
                  value="<%= currentApiEndpoint %>"
                  required
                >
                <div class="form-text text-muted">
                  Default: http://172.18.100.184/mini_project/public/api
                </div>
                <div class="form-text mt-2">
                  <i class="fas fa-info-circle"></i> Enter the base URL for the API server. For example:
                  <ul>
                    <li>http://172.18.100.184/mini_project/public/api</li>
                    <li>http://172.18.149.123/mini_project/public/api</li>
                  </ul>
                </div>
              </div>
            </div>
            
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Save Settings
              </button>
              <a href="/" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Home
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>
