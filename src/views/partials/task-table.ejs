<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th scope="col">Jira ID</th>
        <th scope="col">Summary</th>
        <th scope="col">Team</th>
        <th scope="col">Working Status</th>
        <th scope="col">Ticket Status</th>
        <th scope="col">Created At</th>
      </tr>
    </thead>
    <tbody>
      <% if (tasks && tasks.length > 0) { %>
        <% tasks.forEach(task => { %>
          <tr>
            <td><%= task.jira_id %></td>
            <td><%= task.jira_summary %></td>
            <td><%= task.team.name %></td>
            <td>
              <span class="badge" style="background-color: <%= task.working_status.desc %>">
                <%= task.working_status.name %>
              </span>
            </td>
            <td>
              <span class="badge" style="background-color: <%= task.ticket_status.desc %>">
                <%= task.ticket_status.name %>
              </span>
            </td>
            <td><%= new Date(task.created_at).toLocaleString() %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="6" class="text-center">No tasks found</td>
        </tr>
      <% } %>
    </tbody>
    <tfoot>
      <tr class="table-secondary">
        <td colspan="6" class="text-end">
          <strong>Total Tasks: <%= tasks ? tasks.length : 0 %></strong>
        </td>
      </tr>
    </tfoot>
  </table>
</div>
