<%- include('../partials/header') %>

<div class="row mb-4">
  <div class="col-md-12">
    <div class="card shadow-sm">
      <div class="card-header">
        <h2>Custom Date Range Report</h2>
        <p class="text-muted mb-0">Generate a report of tasks for a custom date range</p>
      </div>
      <div class="card-body">
        <form action="/reports/generate" method="POST" id="reportForm">
          <input type="hidden" name="reportType" value="custom">
          
          <div class="row">
            <!-- Date Range Selection -->
            <div class="col-md-6 mb-4">
              <div class="row">
                <div class="col-md-6">
                  <div class="form-group mb-3">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input type="date" id="startDate" name="startDate" class="form-control" 
                           value="<%= startDate %>" required>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="form-group mb-3">
                    <label for="endDate" class="form-label">End Date</label>
                    <input type="date" id="endDate" name="endDate" class="form-control" 
                           value="<%= endDate %>" required>
                  </div>
                </div>
              </div>
              
              <div class="btn-group w-100 mb-3">
                <button type="button" class="btn btn-outline-secondary" onclick="setLastWeek()">Last Week</button>
                <button type="button" class="btn btn-outline-secondary" onclick="setLastMonth()">Last Month</button>
                <button type="button" class="btn btn-outline-secondary" onclick="setLastQuarter()">Last Quarter</button>
              </div>
            </div>
            
            <!-- Email Configuration -->
            <div class="col-md-6 mb-4">
              <div class="form-group mb-3">
                <label for="subject" class="form-label">Email Subject</label>
                <input type="text" id="subject" name="subject" class="form-control"
                       value="<%= emailConfig.subject %>" required>
              </div>
              
              <div class="form-group mb-3">
                <label for="to" class="form-label">To (separate emails with comma)</label>
                <input type="text" id="to" name="to" class="form-control"
                       placeholder="recipient1@example.com, recipient2@example.com" required>
              </div>
              
              <div class="form-group mb-3">
                <label for="cc" class="form-label">CC (separate emails with comma)</label>
                <input type="text" id="cc" name="cc" class="form-control"
                       placeholder="cc1@example.com, cc2@example.com">
              </div>
            </div>
          </div>

          <!-- Board Selection -->
          <div class="form-group mt-3">
            <label for="boardId" class="form-label">Select Board</label>
            <select id="boardId" name="boardId" class="form-select">
              <% if (boards && boards.length > 0) { %>
                <% boards.forEach(board => { %>
                  <option value="<%= board.id %>" <%= currentBoardId == board.id ? 'selected' : '' %>><%= board.name %></option>
                <% }); %>
              <% } else { %>
                <option value="1">Default Board</option>
              <% } %>
            </select>
          </div>
          
          <div class="d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary">Generate Report</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Help Card -->
<div class="row">
  <div class="col-md-12">
    <div class="card bg-light">
      <div class="card-body">
        <h5 class="card-title"><i class="fas fa-info-circle me-2"></i>What is a Custom Date Range Report?</h5>
        <p class="card-text">
          A custom date range report allows you to specify any start and end dates to analyze tasks. Use this report to:
        </p>
        <ul>
          <li>Generate reports for specific project phases</li>
          <li>Create quarterly or monthly summaries</li>
          <li>Compare task data across different time periods</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
  // Helper functions for date presets
  function setLastWeek() {
    const today = new Date();
    const lastWeek = new Date(today);
    lastWeek.setDate(today.getDate() - 7);
    
    document.getElementById('startDate').value = formatDate(lastWeek);
    document.getElementById('endDate').value = formatDate(today);
    updateSubject(lastWeek, today);
  }
  
  function setLastMonth() {
    const today = new Date();
    const lastMonth = new Date(today);
    lastMonth.setMonth(today.getMonth() - 1);
    
    document.getElementById('startDate').value = formatDate(lastMonth);
    document.getElementById('endDate').value = formatDate(today);
    updateSubject(lastMonth, today);
  }
  
  function setLastQuarter() {
    const today = new Date();
    const lastQuarter = new Date(today);
    lastQuarter.setMonth(today.getMonth() - 3);
    
    document.getElementById('startDate').value = formatDate(lastQuarter);
    document.getElementById('endDate').value = formatDate(today);
    updateSubject(lastQuarter, today);
  }
  
  function formatDate(date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }
  
  function updateSubject(startDate, endDate) {
    const formattedStart = formatDate(startDate);
    const formattedEnd = formatDate(endDate);
    document.getElementById('subject').value = `Task Report (${formattedStart} - ${formattedEnd})`;
  }
</script>

<%- include('../partials/footer') %>
