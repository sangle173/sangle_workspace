<%- include('../partials/header') %>

<div class="row mb-4">
  <div class="col-md-12">
    <div class="card shadow-sm">
      <div class="card-header">
        <h2>Weekly Report</h2>
        <p class="text-muted mb-0">Generate a report of tasks for a specific week</p>
      </div>
      <div class="card-body">
        <form action="/reports/generate" method="POST" id="reportForm">
          <input type="hidden" name="reportType" value="weekly">
          
          <div class="row">
            <!-- Week Selection -->
            <div class="col-md-6 mb-4">
              <div class="form-group mb-3">
                <label for="weekStart" class="form-label">Start Date</label>
                <input type="date" id="weekStart" name="weekStart" class="form-control" 
                       value="<%= weekStart %>" required>
              </div>
              
              <div class="form-group mb-3">
                <label for="weekEnd" class="form-label">End Date</label>
                <input type="date" id="weekEnd" name="weekEnd" class="form-control" 
                       value="<%= weekEnd %>" required>
              </div>
              
              <p class="text-muted">
                Report will include tasks from <%= weekStart %> to <%= weekEnd %>
              </p>
            </div>
            
            <!-- Email Configuration -->
            <div class="col-md-6 mb-4">
              <div class="form-group mb-3">
                <label for="subject" class="form-label">Email Subject</label>
                <input type="text" id="subject" name="subject" class="form-control"
                       value="<%= emailConfig.subject %>" required>
              </div>
              
              <div class="form-group mb-3">
                <label for="to" class="form-label">To (separate emails with comma)</label>
                <input type="text" id="to" name="to" class="form-control"
                       placeholder="recipient1@example.com, recipient2@example.com" required>
              </div>
              
              <div class="form-group mb-3">
                <label for="cc" class="form-label">CC (separate emails with comma)</label>
                <input type="text" id="cc" name="cc" class="form-control"
                       placeholder="cc1@example.com, cc2@example.com">
              </div>
            </div>
          </div>

          <!-- Board Selection -->
          <div class="form-group mt-3">
            <label for="boardId" class="form-label">Select Board</label>
            <select id="boardId" name="boardId" class="form-select">
              <% if (boards && boards.length > 0) { %>
                <% boards.forEach(board => { %>
                  <option value="<%= board.id %>" <%= currentBoardId == board.id ? 'selected' : '' %>><%= board.name %></option>
                <% }); %>
              <% } else { %>
                <option value="1">Default Board</option>
              <% } %>
            </select>
          </div>
          
          <div class="d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary">Generate Report</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Help Card -->
<div class="row">
  <div class="col-md-12">
    <div class="card bg-light">
      <div class="card-body">
        <h5 class="card-title"><i class="fas fa-info-circle me-2"></i>What is a Weekly Report?</h5>
        <p class="card-text">
          A weekly report shows all tasks created during the selected week. Use this report to:
        </p>
        <ul>
          <li>Track weekly progress across teams</li>
          <li>Generate sprint summary reports</li>
          <li>Prepare for weekly status meetings</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
