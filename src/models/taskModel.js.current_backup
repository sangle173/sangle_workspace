      taskTitle: 'font-family: Calibri, sans-serif; font-size: 11pt; font-weight: bold;',
      taskDetail: 'font-family: Calibri, sans-serif; font-size: 11pt; padding-left: 12pt; margin-top: 3pt;',
      link: 'font-family: Calibri, sans-serif; font-size: 11pt; color: #0066cc; text-decoration: underline;'
    };

    let content = `
      <div style="${styles.container}">
        <h1 style="${styles.h1}">Task Report for ${board.name}</h1>
        <p style="${styles.p}">Total Tasks: <strong style="font-family: Calibri, sans-serif;">${tasks.length}</strong></p>
    `;
    
    // First section: Tasks by Type
    content += `
      <div style="margin-top: 20pt; margin-bottom: 15pt; font-family: Calibri, sans-serif;">
        <h2 style="${styles.h2}">Tasks by Type</h2>
    `;
    
    Object.entries(tasksByType).forEach(([type, typeTasks]) => {
      content += `
        <div style="margin-bottom: 15pt; font-family: Calibri, sans-serif;">
          <h3 style="${styles.h3}">${type} (${typeTasks.length} tasks)</h3>
      `;
      
      typeTasks.forEach(task => {
        // Create Jira hyperlink
        const jiraUrl = `https://jira.sonos.com/browse/${task.jira_id}`;
        
        content += `
          <div style="margin-left: 10pt; margin-bottom: 8pt; font-family: Calibri, sans-serif;">
            <div style="${styles.taskTitle}">
              <a href="${jiraUrl}" style="${styles.link}" target="_blank">${task.jira_id}</a>: 
              ${task.jira_summary} [${task.ticket_status.name}]
            </div>
        `;
        
        if (task.link_to_result) {
          content += `<div style="padding-left: 20pt; font-family: Calibri, sans-serif;">Link to Results: <a href="${task.link_to_result}" style="${styles.link}" target="_blank">${task.link_to_result}</a></div>`;
        }
        
        content += `</div>`;
      });
      
      content += `</div>`;
    });
    
    // Second section: Tasks by Team
    content += `
      </div>
      <div style="margin-top: 30pt; margin-bottom: 15pt; font-family: Calibri, sans-serif;">
        <h2 style="${styles.h2}">Tasks by Team</h2>
    `;
    
    Object.entries(tasksByTeam).forEach(([team, teamTasks]) => {
      content += `
        <div style="margin-bottom: 20pt; font-family: Calibri, sans-serif;">
          <h3 style="${styles.h3}">${team} (${teamTasks.length} tasks)</h3>
      `;
      
      teamTasks.forEach(task => {
        // Create Jira hyperlink
        const jiraUrl = `https://jira.sonos.com/browse/${task.jira_id}`;
        
        content += `
          <div style="margin-left: 10pt; margin-bottom: 8pt; font-family: Calibri, sans-serif;">
            <div style="${styles.taskTitle}">
              <a href="${jiraUrl}" style="${styles.link}" target="_blank">${task.jira_id}</a>: 
              ${task.jira_summary} [${task.ticket_status.name}]
            </div>
        `;
        
        if (task.link_to_result) {
          content += `<div style="padding-left: 20pt; font-family: Calibri, sans-serif;">Link to Results: <a href="${task.link_to_result}" style="${styles.link}" target="_blank">${task.link_to_result}</a></div>`;
        }
        
        content += `</div>`;
      });
      
      content += `</div>`;
    });

    content += `</div>`;
    return content;
  }

